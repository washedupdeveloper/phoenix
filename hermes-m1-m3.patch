diff -ruN a/modules/hermes.nix b/modules/hermes.nix
--- a/modules/hermes.nix	1970-01-01 00:00:00.000000000 +0000
+++ b/modules/hermes.nix	2026-09-30 19:44:46.850750128 +0000
@@ -0,0 +1,30 @@
+{ config, username, ... }:
+{
+  clan.core.vars.generators.hermes = {
+    prompts.api-key = {
+      description = "Surplus Intelligence API key";
+      type = "hidden";
+      persist = false;
+    };
+    files.env = {
+      owner = username;
+      mode = "0400";
+    };
+    script = ''
+      printf 'OPENAI_API_KEY=%s\n' "$(cat $prompts/api-key)" > $out/env
+    '';
+  };
+
+  home-manager.users.${username} = {
+    programs.hermes-agent.enable = true;
+    services.hermes-agent = {
+      enable = true;
+      environmentFiles = [ config.clan.core.vars.generators.hermes.files.env.path ];
+      settings.model = {
+        provider = "custom";
+        base_url = "https://api.surplusintelligence.ai/v1";
+        default = "deepseek-v4.1-flash";
+      };
+    };
+  };
+}
